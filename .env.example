# RedScope 环境配置
# 复制此文件为 .env 并修改配置
# ⚠️ 生产环境必须修改 SECRET_KEY 和 DB_PASSWORD

# 运行环境 (development / production)
# 生产环境会强制校验 SECRET_KEY 强度，禁用 debug
ENVIRONMENT=development

# 数据库密码（务必修改）
DB_PASSWORD=请修改为强密码

# Redis密码
REDIS_PASSWORD=请修改为强密码

# JWT密钥（生产环境必须 >= 32位随机字符串）
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请修改为随机字符串

# LLM API配置（用于AI辅助报告生成和LLM安全测试，可选）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 通知Webhook（企业微信/钉钉/飞书，可选）
NOTIFY_WEBHOOK_URL=
NOTIFY_CHANNEL=wecom

# Scan Runner 通信密钥
RUNNER_SECRET=请修改为随机字符串
