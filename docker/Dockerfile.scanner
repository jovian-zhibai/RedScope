FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY scan-runner/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY scan-runner/main.py /app/main.py

RUN groupadd -r scanner && useradd -r -g scanner -G root scanner
RUN mkdir -p /app/output && chown -R scanner:scanner /app/output

USER scanner
EXPOSE 9090

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "9090"]
